{
  "layoutVersion": "1.1",
  "screen": {
    "width": 1080,
    "height": 1920,
    "orientation": "portrait",
    "coordinateSystem": "top-left",
    "baseScale": { "x": 1080, "y": 1920 }
  },
  "reference": {
    "source": "animal_head_matching_base",
    "purpose": "Layout template EXCLUSIVO para a TELA DE JOGO (telaJogo). As demais telas (menu, mapa, perfis, cria) têm layout próprio e não usam este arquivo.",
    "fitMode": "cover",
    "designReferenceSize": "1080x1920",
    "totalFases": 10,
    "fasesComMateriais": {
      "1": "madeira", "2": "madeira",
      "3": "palha",   "4": "palha",
      "5": "folha",
      "6": "gelo",
      "7": "nuvem",
      "8": "ouro",
      "9": "madeira",
      "10": "cristal"
    },
    "pontuacao": {
      "porAcerto": 10,
      "persistencia": "acumulativa no perfil",
      "streakReset": "ao errar"
    }
  },
  "safeArea": {
    "top": 100,
    "bottom": 100,
    "left": 24,
    "right": 24
  },
  "layers": {
    "background": 0,
    "environment": 10,
    "character": 20,
    "choiceHeads": 30,
    "ui": 50,
    "effects": 70,
    "feedback": 80
  },
  "elements": {
    "btnBack": {
      "type": "button", "anchor": "center",
      "x": 110, "y": 195, "width": 125, "height": 125,
      "hitArea": { "width": 145, "height": 145 },
      "zIndex": 50, "assetRole": "theme.backButton"
    },
    "btnRestart": {
      "type": "button", "anchor": "center",
      "x": 970, "y": 195, "width": 125, "height": 125,
      "hitArea": { "width": 145, "height": 145 },
      "zIndex": 50, "assetRole": "theme.restartButton"
    },
    "phaseHeader": {
      "type": "panel", "anchor": "center",
      "x": 540, "y": 185, "width": 650, "height": 125,
      "zIndex": 50, "assetRole": "theme.phaseHeader"
    },
    "phaseTitle": {
      "type": "text", "anchor": "center",
      "x": 540, "y": 177, "width": 560, "height": 65,
      "fontSize": 48, "fontWeight": "800", "align": "center",
      "maxLines": 1,
      "autoShrink": true,
      "minFontSize": 32,
      "zIndex": 51,
      "content": "FASE {n} • {title}",
      "format": "uppercase"
    },
    "phaseProgress": {
      "type": "panel", "anchor": "center",
      "x": 540, "y": 272, "width": 520, "height": 78,
      "zIndex": 50, "assetRole": "theme.phaseProgress"
    },
    "scorePanel": {
      "type": "panel", "anchor": "center",
      "x": 150, "y": 380, "width": 245, "height": 105,
      "zIndex": 50, "assetRole": "theme.scorePanel",
      "icon": "⭐",
      "label": "pontos"
    },
    "scoreText": {
      "type": "text", "anchor": "center",
      "x": 183, "y": 384, "width": 145, "height": 70,
      "fontSize": 48, "fontWeight": "800", "align": "center",
      "autoShrink": true, "minFontSize": 28,
      "content": "{pontos}",
      "zIndex": 51
    },
    "streakPanel": {
      "type": "panel", "anchor": "center",
      "x": 930, "y": 380, "width": 245, "height": 105,
      "zIndex": 50, "assetRole": "theme.streakPanel",
      "icon": "🔥",
      "pulseOnIncrement": true,
      "pulseDurationMs": 550
    },
    "streakText": {
      "type": "text", "anchor": "center",
      "x": 940, "y": 380, "width": 160, "height": 70,
      "fontSize": 48, "fontWeight": "800", "align": "center",
      "content": "{streak}x",
      "zIndex": 51
    },
    "animalStage": {
      "type": "stage", "anchor": "center",
      "x": 540, "y": 1030, "width": 500, "height": 610,
      "zIndex": 15
    },
    "animalBody": {
      "type": "animalBody", "anchor": "center",
      "x": 540, "y": 1030, "width": 455, "height": 500,
      "zIndex": 20, "assetRole": "animals.body",
      "snapPoint": { "x": 540, "y": 805 },
      "headSocket": { "x": 540, "y": 805, "width": 180, "height": 150 }
    },
    "headSlot01": { "type": "choiceSlot", "anchor": "center", "x": 175,  "y": 720,  "width": 185, "height": 185, "zIndex": 30, "assetRole": "theme.choiceFrame", "activeWhen": "opcoes >= 3" },
    "headSlot02": { "type": "choiceSlot", "anchor": "center", "x": 905,  "y": 720,  "width": 185, "height": 185, "zIndex": 30, "assetRole": "theme.choiceFrame", "activeWhen": "opcoes >= 3" },
    "headSlot03": { "type": "choiceSlot", "anchor": "center", "x": 130,  "y": 1050, "width": 185, "height": 185, "zIndex": 30, "assetRole": "theme.choiceFrame", "activeWhen": "opcoes >= 3" },
    "headSlot04": { "type": "choiceSlot", "anchor": "center", "x": 950,  "y": 1050, "width": 185, "height": 185, "zIndex": 30, "assetRole": "theme.choiceFrame", "activeWhen": "opcoes >= 4" },
    "headSlot05": { "type": "choiceSlot", "anchor": "center", "x": 540,  "y": 1350, "width": 190, "height": 190, "zIndex": 30, "assetRole": "theme.choiceFrame", "activeWhen": "opcoes >= 5" },
    "instructionPanel": {
      "type": "panel", "anchor": "center",
      "x": 540, "y": 1555, "width": 650, "height": 125,
      "zIndex": 50, "assetRole": "theme.instructionPanel"
    },
    "instructionText": {
      "type": "text", "anchor": "center",
      "x": 540, "y": 1555, "width": 470, "height": 65,
      "fontSize": 40, "fontWeight": "800", "align": "center",
      "autoShrink": true, "minFontSize": 28,
      "content": "Escolha um animal",
      "zIndex": 51
    }
  },
  "animalAlignment": {
    "bodyAnchor": "center",
    "headSnapMode": "center",
    "headSnapTarget": "animalBody.headSocket",
    "onCorrect": { "animateTo": "animalBody.headSocket", "preserveScale": false, "durationMs": 450, "easing": "easeOutBack" },
    "onWrong":   { "shakeMs": 300, "returnToOriginalPosition": true }
  },
  "responsiveRules": {
    "scaleFromBase": "min(viewportWidth/1080, viewportHeight/1920)",
    "keepAspectRatio": true,
    "letterboxOutsideBase": false,
    "backgroundFillsScreen": true,
    "uiPositioning": "useBaseCoordinates",
    "doNotRecalculateElementPositionsPerPhase": true,
    "safeAreaInsets": "useEnvSafeAreaInset"
  },
  "themeSwap": {
    "background": "replaceable",
    "panels": "replaceable",
    "choiceFrames": "replaceable",
    "effects": "replaceable",
    "fixedGeometry": true
  }
}